{
    "manifest_version":3,
    "name":"Page Text Extractor",
    "description":"Extract all visible text from any webpage",
    "actions":{
        "default_popup":"popup.html",
        "default_icon":{
            "16":"icons/icon16.png",
            "48":"icons/icon48.png",
            "128":"icons/icon128.png"
        }
    },
    "permissions":[
        "activeTab",
        "scripting"
    ],
    "icons":{
        "16":"icons/icon16.png",
        "48":"icons/icon48.png",
        "128":"icons/icon128.png"
    }
}